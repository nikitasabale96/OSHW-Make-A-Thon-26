---
import 'aos/dist/aos.css';
import '../styles/global.css';
import OSHW from "../assets/Images/logo_3.png";
const { title = "OSHW Makeathon 2026", navPosition = "sticky" } =
  Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={OSHW.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@200..1000&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="font-sans bg-page-bg text-text-main antialiased">
    <slot />
  </body>
</html>
